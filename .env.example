# Copy this file to .env and fill in what you use. Never share or upload your .env file.
# All of these are free.

# Groq (free tier, open-weights models): https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter (free ':free' models): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# OpenAlex: free API key from https://openalex.org (optional but gives higher limits)
OPENALEX_API_KEY=
# Optional: OpenAlex "polite pool" contact address (sent only to OpenAlex, never saved in outputs)
OPENALEX_MAILTO=
